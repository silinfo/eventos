# Apache: impedir el acceso web a la configuración
<Files "config.php">
  Require all denied
</Files>
<Files "config.sample.php">
  Require all denied
</Files>
Options -Indexes

# App (PWA)
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
